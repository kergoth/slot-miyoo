+//! Nintendo Switch Online's GBA colour filter, as libretro's
+//! `NSO-gba-color.slang` (sRGB profile) computes it: expand to linear light,
+//! mix the channels through a fixed matrix, clamp, then re-encode with a
+//! gamma that also darkens the picture.
+//!
+//! A GBA frame carries 5 bits a channel, so the whole filter is a table of
+//! 32,768 entries built once; applying it to a frame is one lookup a pixel.
+
+const GAMMA: f32 = 2.2;
+
+/// The shader's `darken_screen` is 0.8; 0.4 keeps its mixing and dims less.
+const DARKEN: f32 = 0.4;
+
+/// Output channel by input channel, in the shader's `GBA_sRGB` weights.
+const MIX: [[f32; 3]; 3] = [
+    [0.865, 0.1225, 0.0125],
+    [0.0575, 0.925, 0.0125],
+    [0.0575, 0.1225, 0.82],
+];
+
+pub const LEN: usize = 1 << 15;
+
+/// Indexed by the top five bits of R, G and B (`r << 10 | g << 5 | b`);
+/// each entry is B, G, R, opaque, which is a canvas pixel as it sits in memory.
+pub fn table() -> Vec<u32> {
+    let exponent = DARKEN / (GAMMA * GAMMA) + 1.0 / GAMMA;
+    let linear: Vec<f32> = (0..32u32)
+        .map(|c| (((c << 3) | (c >> 2)) as f32 / 255.0).powf(GAMMA))
+        .collect();
+    (0..LEN)
+        .map(|i| {
+            let input = [linear[i >> 10], linear[(i >> 5) & 31], linear[i & 31]];
+            let [r, g, b] = MIX.map(|row| {
+                let mixed: f32 = row.iter().zip(input).map(|(w, v)| w * v).sum();
+                ((mixed.clamp(0.0, 1.0).powf(exponent) * 255.0 + 0.5) as u32).min(255)
+            });
+            b | g << 8 | r << 16 | 0xFF00_0000
+        })
+        .collect()
+}
+
+/// `xrgb` and `out` are B, G, R, X pixels of the same length.
+pub fn apply(table: &[u32], xrgb: &[u8], out: &mut [u8]) {
+    for (px, out) in xrgb.chunks_exact(4).zip(out.chunks_exact_mut(4)) {
+        let i = (usize::from(px[2] >> 3) << 10)
+            | (usize::from(px[1] >> 3) << 5)
+            | usize::from(px[0] >> 3);
+        out.copy_from_slice(&table[i].to_le_bytes());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn filtered(r: u8, g: u8, b: u8) -> [u8; 3] {
+        let mut out = [0u8; 4];
+        apply(&table(), &[b, g, r, 0], &mut out);
+        [out[2], out[1], out[0]]
+    }
+
+    fn near(got: [u8; 3], want: [u8; 3]) {
+        assert!(
+            got.iter().zip(want).all(|(g, w)| g.abs_diff(w) <= 1),
+            "{got:?} is not within 1 of {want:?}"
+        );
+    }
+
+    #[test]
+    fn matches_the_shader_on_known_colours() {
+        // Reference values from the shader's own arithmetic in float64 with
+        // the input rounded to five bits and expanded by bit replication.
+        near(filtered(0, 0, 0), [0, 0, 0]);
+        near(filtered(255, 0, 0), [236, 55, 55]);
+        near(filtered(0, 255, 0), [83, 245, 83]);
+        near(filtered(0, 0, 255), [24, 24, 229]);
+        near(filtered(255, 255, 255), [255, 254, 255]);
+    }
+
+    #[test]
+    fn pixels_come_out_opaque_and_in_canvas_order() {
+        let mut out = [0u8; 4];
+        apply(&table(), &[255, 0, 0, 0], &mut out);
+        assert_eq!(out[3], 255);
+        assert!(out[0] > out[2], "blue input must land in byte 0: {out:?}");
+    }
+}
